{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "msedge",
      "request": "launch",
      "name": "pwa-msedge",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--disable-frame-rate-limit",
        "--disable-gpu-vsync"
      ],
      "preLaunchTask": "saveAllFiles"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "pwa-chrome",
      "url": "http://localhost:5500/",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--disable-frame-rate-limit",
        "--disable-gpu-vsync"
      ],
      "preLaunchTask": "saveAllFiles"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Chrome",
      "port": 9222,
      "urlFilter": "http://localhost:5500/*",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "saveAllFiles"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "pwa-chrome-onetrust",
      "url": "https://localhost.echo:5500",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--disable-frame-rate-limit",
        "--disable-gpu-vsync"
      ],
      "preLaunchTask": "saveAllFiles"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "pwa-chrome karma",
      "address": "localhost",
      "port": 9333,
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}",
      "pathMapping": {
        "/": "${workspaceFolder}",
        "/base/": "${workspaceFolder}"
      },
      "preLaunchTask": "saveAllFiles"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "pwa-chrome iPad",
      "url": "http://192.168.0.10:5500",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--disable-frame-rate-limit",
        "--disable-gpu-vsync"
      ],
      "preLaunchTask": "saveAllFiles"
    }
  ],
  "debug.javascript.terminalOptions": {
    "skipFiles": [
      "<node_internals>/**"
    ]
  }
}